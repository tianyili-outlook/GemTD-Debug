+-- Private debug build: reconcile late direct-connect players with the original backend.
+function GemTD:DebugPlayerInfoValid(info)
+	return type(info) == "table" and type(info.hero_sea) == "table"
+		and type(info.quest) == "table" and type(info.onduty_hero) == "table"
+		and info.onduty_hero.hero_id ~= nil
+end
+
+function GemTD:DebugPlayerInfoPlayers()
+	local ids = {}
+	local state = _G.debug_player_info
+	for id = 0, 20 do
+		if PlayerResource:GetPlayer(id) and PlayerResource:GetConnectionState(id) == DOTA_CONNECTION_STATE_CONNECTED then
+			local steamid = tostring(PlayerResource:GetSteamID(id))
+			if steamid ~= "0" then
+				table.insert(ids, steamid)
+				if state.seen[id] ~= steamid then
+					state.seen[id] = steamid
+					print('[GemTD Debug] player connected id='..id..' steamid='..steamid)
+				end
+			end
+		else
+			state.seen[id] = nil
+		end
+	end
+	return ids
+end
+
+function GemTD:DebugPlayerInfoWatch()
+	if _G.myself ~= true then return end
+	local state = _G.debug_player_info
+	if state.watching or GameRules:State_Get() >= DOTA_GAMERULES_STATE_POST_GAME then return end
+	state.watching = true
+	Timers:CreateTimer({useGameTime = false, endTime = 0.1, callback = function()
+		if _G.debug_player_info ~= state or _G.myself ~= true or GameRules:State_Get() >= DOTA_GAMERULES_STATE_POST_GAME then
+			state.watching = false
+			return
+		end
+		-- Resume only the still-current placeholder hero, never a stale reconnect entity.
+		for index, keys in pairs(state.pending) do
+			local hero = EntIndexToHScript(index)
+			if hero == nil or hero:IsNull() or PlayerResource:GetSelectedHeroEntity(hero:GetPlayerID()) ~= hero then
+				state.pending[index] = nil
+			elseif PlayerResource:GetConnectionState(hero:GetPlayerID()) == DOTA_CONNECTION_STATE_CONNECTED then
+				local steamid = tostring(PlayerResource:GetSteamID(hero:GetPlayerID()))
+				if self:DebugPlayerInfoValid(CustomNetTables:GetTableValue("player_info_table", "player_info_"..steamid)) then
+					self:OnPlayerPickHero(keys)
+				end
+			end
+		end
+		if GameRules:State_Get() > DOTA_GAMERULES_STATE_PRE_GAME and next(state.pending) == nil then
+			state.watching = false
+			return
+		end
+		self:OnPlayerStartTeamSelect({})
+		return 1
+	end})
+end
+
+function GemTD:DebugPlayerInfoRequest()
+	local state = _G.debug_player_info
+	if GameRules:State_Get() >= DOTA_GAMERULES_STATE_POST_GAME then return nil end
+	if GameRules:State_Get() > DOTA_GAMERULES_STATE_PRE_GAME and next(state.pending) == nil then return nil end
+	local ids = self:DebugPlayerInfoPlayers()
+	local missing = false
+	for _, steamid in ipairs(ids) do
+		if not self:DebugPlayerInfoValid(CustomNetTables:GetTableValue("player_info_table", "player_info_"..steamid)) then missing = true end
+	end
+	local signature = table.concat(ids, ',')
+	if not missing and #ids > 0 then
+		if state.ready ~= signature then
+			print('[GemTD Debug] player-info READY steamids='..signature..' (all connected players; safe to Start Game)')
+			state.ready = signature
+		end
+		return nil
+	end
+	state.ready = nil
+	if #ids == 0 or state.inflight or Time() < state.retry_at then return nil end
+	state.inflight = true
+	print('[GemTD Debug] player-info refresh started steamids='..signature)
+	return ids
+end
